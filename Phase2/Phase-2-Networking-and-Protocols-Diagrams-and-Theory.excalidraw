      "updated": 1761490000,
      "link": null,
      "locked": false,
      "text": "Edge cache reduces latency and origin load\nTTL = freshness window • purge/invalidation removes stale objects\nNever share-cache private/personalized responses by accident",
      "fontSize": 15,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 18,
      "containerId": null,
      "originalText": "Edge cache reduces latency and origin load\nTTL = freshness window • purge/invalidation removes stale objects\nNever share-cache private/personalized responses by accident",
      "autoResize": true,
      "lineHeight": 1.25
    },
