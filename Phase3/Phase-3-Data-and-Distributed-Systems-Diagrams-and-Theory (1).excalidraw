    {
      "id": "phase3-0125",
      "type": "text",
      "x": 115,
      "y": 2285,
      "width": 820,
      "height": 255,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 2125,
      "version": 1,
      "versionNonce": 3625,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1761490000000,
      "link": null,
      "locked": false,
      "fontSize": 17,
      "fontFamily": 5,
      "text": "CONCURRENCY CONTROL\n• Race condition: correctness depends on concurrent interleaving.\n• Pessimistic locking holds a lock; useful for frequent conflicts but can block/deadlock.\n• Optimistic control checks a version / compare-and-swap and retries on conflict.\n• Prefer atomic conditional updates for single-document invariants.\n• Keep transactions short; use consistent lock order; retry aborted work safely.\n• Distributed locks need lease-expiry and stale-holder safeguards; prefer database invariants when possible.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "CONCURRENCY CONTROL\n• Race condition: correctness depends on concurrent interleaving.\n• Pessimistic locking holds a lock; useful for frequent conflicts but can block/deadlock.\n• Optimistic control checks a version / compare-and-swap and retries on conflict.\n• Prefer atomic conditional updates for single-document invariants.\n• Keep transactions short; use consistent lock order; retry aborted work safely.\n• Distributed locks need lease-expiry and stale-holder safeguards; prefer database invariants when possible.",
      "autoResize": true,
      "lineHeight": 1.25
    },
