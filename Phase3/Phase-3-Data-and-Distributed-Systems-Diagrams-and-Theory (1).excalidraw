    {
      "id": "phase3-0108",
      "type": "text",
      "x": 1075,
      "y": 1710,
      "width": 820,
      "height": 220,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1836,
      "version": 1,
      "versionNonce": 3132,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1761490000000,
      "link": null,
      "locked": false,
      "fontSize": 17,
      "fontFamily": 5,
      "text": "CROSS-SERVICE WORKFLOWS\n• 2PC: prepare then commit/abort; can block and hold resources during failures.\n• Saga: local transactions + compensating business actions.\n• Choreography = event reactions; orchestration = explicit workflow coordinator.\n• Transactional outbox: write business change + outbox row in one local transaction, then publish.\n• Expect duplicate delivery; use idempotent consumers and stable event IDs.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "CROSS-SERVICE WORKFLOWS\n• 2PC: prepare then commit/abort; can block and hold resources during failures.\n• Saga: local transactions + compensating business actions.\n• Choreography = event reactions; orchestration = explicit workflow coordinator.\n• Transactional outbox: write business change + outbox row in one local transaction, then publish.\n• Expect duplicate delivery; use idempotent consumers and stable event IDs.",
      "autoResize": true,
      "lineHeight": 1.25
    },
