    {
      "id": "p4-0038",
      "type": "text",
      "x": 1198,
      "y": 1163,
      "width": 404,
      "height": 69,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
