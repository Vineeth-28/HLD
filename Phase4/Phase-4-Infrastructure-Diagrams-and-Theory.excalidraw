      "roundness": null,
      "seed": 462,
      "version": 1,
      "versionNonce": 546,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1761490000000,
      "link": null,
      "locked": false,
      "fontSize": 20,
      "fontFamily": 5,
      "text": "REVISION ROUTINE: redraw both diagrams from memory • compare trade-offs • explain one Node.js API and one queue-worker deployment • answer the interview questions in the Markdown notes.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "REVISION ROUTINE: redraw both diagrams from memory • compare trade-offs • explain one Node.js API and one queue-worker deployment • answer the interview questions in the Markdown notes.",
