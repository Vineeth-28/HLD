      "seed": 494,
      "version": 1,
      "versionNonce": 646,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1761490000000,
      "link": null,
      "locked": false,
      "fontSize": 17,
      "fontFamily": 5,
      "text": "TLS / ENCRYPTION IN TRANSIT\n• Protects a network connection; server normally sees plaintext after TLS termination.\n• Encryption at rest protects stored data.\n• E2EE means only intended endpoint(s) hold the keys needed to read content.\n• Use established, reviewed protocols—not custom crypto.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "TLS / ENCRYPTION IN TRANSIT\n• Protects a network connection; server normally sees plaintext after TLS termination.\n• Encryption at rest protects stored data.\n• E2EE means only intended endpoint(s) hold the keys needed to read content.\n• Use established, reviewed protocols—not custom crypto.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "p5-0039",
      "type": "text",
      "x": 930,
      "y": 945,
      "width": 790,
      "height": 210,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 507,
      "version": 1,
      "versionNonce": 663,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1761490000000,
      "link": null,
      "locked": false,
      "fontSize": 17,
      "fontFamily": 5,
      "text": "THREAT MODEL\n• Protect assets, trust boundaries, keys and endpoints.\n• Plan key rotation, device changes, recovery and revocation.\n• E2EE does not prevent compromised devices or all metadata leakage.\n• Add authorization, input validation, rate limits, patching, and secret hygiene.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "THREAT MODEL\n• Protect assets, trust boundaries, keys and endpoints.\n• Plan key rotation, device changes, recovery and revocation.\n• E2EE does not prevent compromised devices or all metadata leakage.\n• Add authorization, input validation, rate limits, patching, and secret hygiene.",
      "autoResize": true,
      "lineHeight": 1.25
    },
